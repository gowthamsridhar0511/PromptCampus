
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>PromptCampus | Think Smarter. Create Better.</title>

<meta name="description" content="PromptCampus is a digital-first brand exploring AI, creativity, technology and digital resources.">

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
    --bg: #060A13;
    --surface: #0D1626;
    --cyan: #00D9FF;
    --blue: #147BFF;
    --text: #F5F9FF;
    --muted: #98A9BF;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--text);
    font-family: Inter, Arial, sans-serif;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: 84%;
    max-width: 1250px;
    margin: auto;
}

/* NAVIGATION */

header {
    height: 82px;
    display: flex;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6,10,19,.94);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid #1a2a40;
}

.nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1.5px;
}

.logo span {
    color: var(--cyan);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
}

.nav-links a {
    color: #BBC9DB;
    font-size: 13px;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--cyan);
}

.nav-contact {
    padding: 12px 20px;
    border: 1px solid var(--cyan);
    color: var(--cyan) !important;
    border-radius: 7px;
}

.menu-btn {
    display: none;
    background: none;
    color: white;
    border: 0;
    font-size: 28px;
    cursor: pointer;
}

/* HERO */

.hero {
    min-height: 690px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(ellipse at 78% 40%, #073A69 0%, transparent 40%),
        radial-gradient(ellipse at 15% 95%, #10234A 0%, transparent 42%),
        var(--bg);
}

.hero::after {
    content: "";
    position: absolute;
    width: 400px;
    height: 400px;
    right: 8%;
    top: 18%;
    border-radius: 50%;
    border: 1px solid rgba(0,217,255,.17);
    box-shadow:
        0 0 90px rgba(0,150,255,.12),
        inset 0 0 90px rgba(0,217,255,.08);
    animation: float 7s ease-in-out infinite;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 750px;
}

.eyebrow {
    color: var(--cyan);
    font-size: 11px;
    letter-spacing: 5px;
    font-weight: 700;
    margin-bottom: 28px;
}

.hero h1 {
    font-size: clamp(48px, 7vw, 86px);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -4px;
}

.hero h1 span {
    color: var(--cyan);
    text-shadow: 0 0 35px rgba(0,217,255,.25);
}

.hero-description {
    color: var(--muted);
    max-width: 570px;
    line-height: 1.9;
    font-size: 15px;
    margin-top: 28px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    margin-top: 35px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;
    padding: 15px 25px;
    border-radius: 7px;
    font-weight: 700;
    font-size: 13px;
    transition: .3s;
}

.btn-primary {
    background: var(--cyan);
    color: #00101A;
}

.btn-primary:hover {
    background: white;
    transform: translateY(-3px);
}

.btn-outline {
    border: 1px solid #30465F;
    color: white;
}

.btn-outline:hover {
    border-color: var(--cyan);
    color: var(--cyan);
}

.hero-bottom {
    margin-top: 65px;
    color: #70849F;
    font-size: 11px;
    letter-spacing: 2px;
}

/* COMMON SECTIONS */

section:not(.hero) {
    padding: 105px 0;
}

.section-label {
    color: var(--cyan);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 4px;
    margin-bottom: 20px;
}

.section-title {
    font-size: clamp(32px, 4vw, 48px);
    letter-spacing: -1.5px;
    line-height: 1.2;
    margin-bottom: 22px;
}

.section-description {
    max-width: 720px;
    color: var(--muted);
    font-size: 14px;
    line-height: 2;
}

/* ABOUT */

.about {
    background: #0B1321;
    border-top: 1px solid #17283C;
    border-bottom: 1px solid #17283C;
}

.about-grid {
    display: grid;
    grid-template-columns: 1.2fr .8fr;
    gap: 70px;
    align-items: center;
}

.about-visual {
    min-height: 300px;
    border: 1px solid #1B4264;
    border-radius: 15px;
    background:
        radial-gradient(circle at center, #10456C, #101C30 55%, #0A101B);
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    box-shadow: 0 0 50px rgba(0,160,255,.08);
}

.about-visual strong {
    font-size: 42px;
    color: var(--cyan);
    letter-spacing: -2px;
}

.about-visual span {
    margin-top: 12px;
    color: #9AAEC6;
    font-size: 11px;
    letter-spacing: 3px;
}

/* SERVICES */

.services-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
    margin-top: 45px;
}

.service-card {
    background: var(--surface);
    border: 1px solid #1D3049;
    padding: 30px 24px;
    border-radius: 12px;
    transition: .3s;
}

.service-card:hover {
    transform: translateY(-7px);
    border-color: var(--cyan);
    box-shadow: 0 12px 40px rgba(0,180,255,.08);
}

.service-icon {
    font-size: 32px;
    margin-bottom: 24px;
}

.service-card h3 {
    font-size: 16px;
    margin-bottom: 15px;
}

.service-card p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.9;
}

/* VISION */

.vision {
    background:
        radial-gradient(ellipse at 50% 100%, #10365A, transparent 60%),
        #0A1220;
    text-align: center;
}

.vision .section-description {
    margin: auto;
}

.vision .section-title span {
    color: var(--cyan);
}

/* CONTACT */

.contact {
    text-align: center;
}

.contact .section-description {
    margin: auto;
}

.contact-links {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 35px;
}

.contact-link {
    border: 1px solid #263A52;
    padding: 15px 23px;
    border-radius: 8px;
    color: var(--cyan);
    font-size: 13px;
    transition: .3s;
}

.contact-link:hover {
    border-color: var(--cyan);
    background: #102238;
}

/* FOOTER */

footer {
    border-top: 1px solid #1A2B40;
    background: #050912;
    padding: 35px 0;
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
}

.footer-content p {
    color: #75869D;
    font-size: 12px;
}

.footer-social {
    color: var(--cyan);
    font-size: 12px;
}

/* ANIMATIONS */

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
}

.reveal {
    opacity: 0;
    transform: translateY(25px);
    transition: opacity .8s, transform .8s;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

/* MOBILE */

@media(max-width: 900px) {
    .services-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .about-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }
}

@media(max-width: 650px) {
    .container {
        width: 90%;
    }

    header {
        height: 72px;
    }

    .menu-btn {
        display: block;
    }

    .nav-links {
        display: none;
        position: absolute;
        top: 72px;
        left: 0;
        width: 100%;
        padding: 25px 5%;
        background: #0A1220;
        border-bottom: 1px solid #263A52;
        flex-direction: column;
        gap: 25px;
        align-items: flex-start;
    }

    .nav-links.open {
        display: flex;
    }

    .hero {
        min-height: 620px;
    }

    .hero h1 {
        letter-spacing: -2px;
    }

    .hero::after {
        width: 220px;
        height: 220px;
        right: -80px;
        top: 15%;
    }

    section:not(.hero) {
        padding: 75px 0;
    }

    .services-grid {
        grid-template-columns: 1fr;
    }

    .footer-content {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media(prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation: none !important;
        scroll-behavior: auto !important;
        transition: none !important;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->

<header>
    <div class="container nav">

        <a href="#home" class="logo">
            PromptCampus<span>.</span>
        </a>

        <button class="menu-btn" id="menuBtn"
                aria-label="Toggle navigation"
                aria-expanded="false">
            ☰
        </button>

        <nav class="nav-links" id="navLinks">
            <a href="#home">Home</a>
            <a href="#about">About</a>
            <a href="#services">Services</a>
            <a href="#vision">Our Vision</a>
            <a href="#contact" class="nav-contact">Contact Us ↗</a>
        </nav>

    </div>
</header>

<!-- HERO -->

<section class="hero" id="home">
    <div class="container">

        <div class="hero-content">

            <div class="eyebrow">
                WELCOME TO THE DIGITAL GENERATION
            </div>

            <h1>
                Think Smarter.<br>
                Create <span>Better.</span>
            </h1>

            <p class="hero-description">
                Discover a new world of AI, technology
                and digital creativity.

                PromptCampus is building smarter digital
                experiences for the next generation.
            </p>

            <div class="hero-buttons">
                <a href="#about" class="btn btn-primary">
                    Discover PromptCampus →
                </a>

                <a href="#contact" class="btn btn-outline">
                    Let's Connect
                </a>
            </div>

            <div class="hero-bottom">
                INNOVATION · CREATIVITY · TECHNOLOGY
            </div>

        </div>
    </div>
</section>

<!-- ABOUT -->

<section class="about" id="about">
    <div class="container about-grid">

        <div class="reveal">

            <div class="section-label">01 / ABOUT US</div>

            <h2 class="section-title">
                More Than Just a Digital Brand.
            </h2>

            <p class="section-description">
                PromptCampus is a digital-first brand focused
                on AI, technology, learning and creativity.

                Our mission is to make useful digital resources
                accessible and help people explore new
                possibilities through technology.

                We're at the beginning of our journey,
                and this is where it starts.
            </p>

        </div>

        <div class="about-visual reveal">
            <strong>PC.</strong>
            <span>THINK · CREATE · INNOVATE</span>
        </div>

    </div>
</section>

<!-- SERVICES -->

<section id="services">
    <div class="container">

        <div class="section-label">02 / WHAT WE EXPLORE</div>

        <h2 class="section-title">
            Our Digital Universe.
        </h2>

        <p class="section-description">
            Our areas of focus reflect the opportunities
            we're working towards.
        </p>

        <div class="services-grid">

            <div class="service-card reveal">
                <div class="service-icon">🤖</div>
                <h3>Artificial Intelligence</h3>
                <p>
                    Explore AI resources, prompts
                    and emerging technologies.
                </p>
            </div>

            <div class="service-card reveal">
                <div class="service-icon">📚</div>
                <h3>Digital Learning</h3>
                <p>
                    Discover learning resources
                    and educational materials.
                </p>
            </div>

            <div class="service-card reveal">
                <div class="service-icon">🎨</div>
                <h3>Digital Creativity</h3>
                <p>
                    Explore creative tools,
                    templates and ideas.
                </p>
            </div>

            <div class="service-card reveal">
                <div class="service-icon">⚡</div>
                <h3>Productivity</h3>
                <p>
                    Discover resources that
                    support smarter workflows.
                </p>
            </div>

        </div>

    </div>
</section>

<!-- VISION -->

<section class="vision" id="vision">
    <div class="container reveal">

        <div class="section-label">03 / OUR VISION</div>

        <h2 class="section-title">
            The Future Is <span>Digital.</span>
        </h2>

        <p class="section-description">
            We believe everyone deserves the opportunity
            to learn, create and grow.

            Our goal is to build a destination where
            technology meets creativity and useful
            digital experiences.
        </p>

        <a href="#contact" class="btn btn-primary">
            Be Part of Our Journey →
        </a>

    </div>
</section>

<!-- CONTACT -->

<section class="contact" id="contact">
    <div class="container reveal">

        <div class="section-label">04 / GET IN TOUCH</div>

        <h2 class="section-title">
            Let's Build Something Great.
        </h2>

        <p class="section-description">
            Have a question, idea or collaboration opportunity?
            Connect with PromptCampus.
        </p>

        <div class="contact-links">

            <a class="contact-link"
               href="mailto:gowthamsridhar2008@gmail.com">
                ✉ Send an Email
            </a>

            <a class="contact-link"
               href="https://www.instagram.com/zdemiiitech.offical/"
               target="_blank"
               rel="noopener noreferrer">
                ◎ Instagram ↗
            </a>

        </div>

    </div>
</section>

<!-- FOOTER -->

<footer>
    <div class="container footer-content">

        <a href="#home" class="logo">
            PromptCampus<span>.</span>
        </a>

        <p>
            © 2026 PromptCampus. All rights reserved.
        </p>

        <a class="footer-social"
           href="https://www.instagram.com/zdemiiitech.offical/"
           target="_blank"
           rel="noopener noreferrer">
            FOLLOW OUR JOURNEY ↗
        </a>

    </div>
</footer>

<script>

// MOBILE NAVIGATION

const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", () => {
    const isOpen = navLinks.classList.toggle("open");

    menuBtn.textContent = isOpen ? "✕" : "☰";
    menuBtn.setAttribute("aria-expanded", isOpen);
});

// CLOSE MOBILE MENU AFTER CLICK

document.querySelectorAll(".nav-links a").forEach(link => {
    link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuBtn.textContent = "☰";
        menuBtn.setAttribute("aria-expanded", "false");
    });
});

// SCROLL ANIMATIONS

const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
        }
    });
}, {
    threshold: 0.12
});

document.querySelectorAll(".reveal").forEach(element => {
    observer.observe(element);
});

console.log("PromptCampus website loaded successfully!");

</script>

</body>
</html>

